# Copy to .env. Local development uses the database from `npm run db:up`.
DATABASE_URL=postgres://hourmere:hourmere@localhost:5432/hourmere
PORT=3000
# Where people open Hourmere; sign-in links, OAuth redirects and cookies use it (https in
# production). `npm run dev` replaces it with the Vite dev server, http://localhost:5173.
PUBLIC_URL=http://localhost:3000

# Required: signs sessions and encrypts sign-in tokens. At least 32 random characters, e.g.
# `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Email for sign-in links: any SMTP provider (Resend, Postmark, SES, your own server), e.g.
#   SMTP_URL=smtps://user:password@smtp.example.com:465   (or smtp://…:587 for STARTTLS)
#   MAIL_FROM=Hourmere <hourmere@example.com>
# Percent-encode special characters in the password; smtp:// must offer STARTTLS unless the
# server is on this machine. Without SMTP_URL, emails (including sign-in links) are printed to
# the server log, e.g. `docker compose logs app`: fine for trying it out alone, but anyone
# who can read the log can sign in as anyone. Hosted deployments must set SMTP_URL.
SMTP_URL=
MAIL_FROM=

# Behind a reverse proxy: its address as the app sees it (comma-separated IPs or CIDR
# ranges). Only then is X-Forwarded-For used to find the client IP for rate limiting; without
# it every visitor would share the proxy's limit. With docker compose the proxy reaches the
# app over a Docker network, e.g. TRUSTED_PROXIES=172.16.0.0/12. Leave empty if nothing is in
# front of the app.
TRUSTED_PROXIES=

# Optional: sign in with Google / Microsoft, each enabled when both values are set.
# Redirect URIs to register: {PUBLIC_URL}/api/auth/callback/google and
# {PUBLIC_URL}/api/auth/callback/microsoft
# Accounts are only created for email addresses the provider confirms. Google does; Microsoft
# Entra ID does not by default: in the app registration, under Token configuration, add the
# optional ID token claims verified_primary_email and verified_secondary_email (Better Auth
# also accepts an email_verified claim; it does not read xms_edov). Without them, Microsoft
# users are refused with EMAIL_NOT_VERIFIED and must sign in with an email link instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# What this process runs: all (the default: API and background jobs in one process), web
# (API only; jobs are queued for a worker) or worker (background jobs only, serving just
# /api/health on PORT). See docs/notifications.md.
HOURMERE_ROLE=

# Self-hosting with docker compose: required, e.g. `openssl rand -base64 32`. Wrap it in single
# quotes if it contains $, # or spaces (compose would otherwise expand or cut it).
POSTGRES_PASSWORD=
