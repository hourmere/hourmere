# Copy to .env. Local development uses the database from `npm run db:up`.
DATABASE_URL=postgres://hourmere:hourmere@localhost:5432/hourmere
PORT=3000
# Where people open Hourmere; sign-in links, OAuth redirects and cookies use it (https in
# production). `npm run dev` replaces it with the Vite dev server, http://localhost:5173.
PUBLIC_URL=http://localhost:3000

# Required: signs sessions and encrypts sign-in tokens. At least 32 random characters, e.g.
# `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Email for sign-in links: any SMTP provider (Resend, Postmark, SES, your own server), e.g.
#   SMTP_URL=smtps://user:password@smtp.example.com:465   (or smtp://…:587 for STARTTLS)
#   MAIL_FROM=Hourmere <hourmere@example.com>
# Percent-encode special characters in the password; smtp:// must offer STARTTLS unless the
# server is on this machine. Without SMTP_URL, emails (including sign-in links) are printed to
# the server log, e.g. `docker compose logs app`: fine for trying it out alone, but anyone
# who can read the log can sign in as anyone. Hosted deployments must set SMTP_URL.
SMTP_URL=
MAIL_FROM=

# Behind a reverse proxy: its address as the app sees it (comma-separated IPs or CIDR
# ranges). Only then is X-Forwarded-For used to find the client IP for rate limiting; without
# it every visitor would share the proxy's limit. With docker compose the proxy reaches the
# app over a Docker network, e.g. TRUSTED_PROXIES=172.16.0.0/12. Leave empty if nothing is in
# front of the app.
TRUSTED_PROXIES=

# Optional. When PUBLIC_URL is https (and not localhost), every response tells browsers to use
# only https for this host for HSTS_MAX_AGE seconds (Strict-Transport-Security). Default
# 31536000 (a year); 0 makes browsers forget it. For includeSubDomains or preload, set the
# header at your reverse proxy instead.
HSTS_MAX_AGE=

# Optional, in whole seconds: how long a client may take to send a request's headers
# (default 20) and the whole request (default 60, enough for the largest body, 2 MB, at about
# 280 kbit/s); slower clients get 408 and are disconnected. HTTP_KEEP_ALIVE_TIMEOUT is how
# long an idle connection stays open between requests (default 125). Keep it above your
# reverse proxy's idle timeout for connections to the app, or the proxy may reuse one the app
# has just closed and answer 502. The default is above the usual ones: nginx upstream
# keepalive_timeout and AWS ALB 60 s, Traefik 90 s, Caddy 120 s.
HTTP_HEADERS_TIMEOUT=
HTTP_REQUEST_TIMEOUT=
HTTP_KEEP_ALIVE_TIMEOUT=

# Optional: sign in with Google / Microsoft, each enabled when both values are set.
# Redirect URIs to register: {PUBLIC_URL}/api/auth/callback/google and
# {PUBLIC_URL}/api/auth/callback/microsoft
# Accounts are only created for email addresses the provider confirms. Google does; Microsoft
# Entra ID does not by default: in the app registration, under Token configuration, add the
# optional ID token claims verified_primary_email and verified_secondary_email (Better Auth
# also accepts an email_verified claim; it does not read xms_edov). Without them, Microsoft
# users are refused with EMAIL_NOT_VERIFIED and must sign in with an email link instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: a separate Google OAuth Web application for calendar connections, independent
# of Google sign-in above. Register {PUBLIC_URL}/api/calendar/google/callback (for npm run
# dev: http://localhost:5173/api/calendar/google/callback). Enable Google Calendar API.
# The browser requests openid, email, calendar.calendarlist.readonly, calendar.events.readonly
# and calendar.events.owned. Select conflict calendars and an owned booking destination
# explicitly in the Calendars page. The API still supports list-only connections.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional: a separate Microsoft Entra Web application, independent of Microsoft sign-in.
# Register {PUBLIC_URL}/api/calendar/microsoft/callback (localhost:5173 for npm run dev).
# Supports organizational and personal Microsoft accounts through the common authority.
# Requests openid, email, offline_access and delegated Calendars.ReadBasic. This connection
# lists calendars only; busy-time synchronization and event writes are not implemented yet.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Required with calendar credentials: `openssl rand -base64 32`. Keep this key stable and
# backed up securely: changing/losing it makes stored calendar tokens unreadable.
CALENDAR_ENCRYPTION_KEY=

# Who may create an account; existing users can always sign in. (`npm run dev` defaults to
# open while both are empty.)
#   first-user (default): the first person to sign in, then only SIGNUP_ALLOWED_DOMAINS
#   closed: only SIGNUP_ALLOWED_DOMAINS and live team invitees
#   open: anyone who can reach this instance
# Pending, unexpired team invitations permit their exact email address in either restricted
# mode. Email ownership must still be proven; joining the team needs separate acceptance.
# SIGNUP_ALLOWED_DOMAINS: comma-separated email domains, e.g. example.com,example.org; exact
# match, so list subdomains separately. Not allowed with open. A new address that may not
# sign up gets no sign-in email.
SIGNUP=
SIGNUP_ALLOWED_DOMAINS=

# What this process runs: all (the default: API and background jobs in one process), web
# (API only; jobs are queued for a worker) or worker (background jobs only, serving just
# /api/health on PORT). See docs/notifications.md.
HOURMERE_ROLE=

# Self-hosting with docker compose: required, e.g. `openssl rand -base64 32`. Wrap it in single
# quotes if it contains $, # or spaces (compose would otherwise expand or cut it).
POSTGRES_PASSWORD=

# Exact website origins allowed to embed public booking pages (comma-separated, at most 32).
# HTTPS required except loopback development. Empty disables embedding. No wildcards/paths.
# Example: https://www.example.com,https://blog.example.com
EMBED_ALLOWED_ORIGINS=
# Optional OAuth 2.1 for MCP connectors; API keys keep working either way. Requires HTTPS
# except on loopback development hosts. Users select an organization and approve access;
# revoke connections at /app/connected-apps. No Google/Microsoft client is required.
MCP_OAUTH_ENABLED=false

# Optional outbound organization booking webhooks. Set identically on web and worker.
# Only new changes are captured; no historical backfill. Requires the independent key below.
WEBHOOKS_ENABLED=false
# Exactly 32 random bytes in base64: `openssl rand -base64 32`. Keep stable and back up.
WEBHOOK_ENCRYPTION_KEY=

# Explicit opt-in for new single-host automatic Google Meet bookings; existing intents continue on disable.
# Requires the Google Calendar client and encryption configuration above.
GOOGLE_MEET_ENABLED=false
