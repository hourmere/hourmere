# Upstream failures use Caddy's global logger too. Omit the complete URI (including
# encoded waitlist/one-time booking capability paths and queries) and all
# capability-bearing request headers and response headers (redirect Location).
{
	log default {
		format filter {
			request>uri replace "REDACTED"
			request>headers delete
			resp_headers delete
		}
	}
}

# PUBLIC_URL must be an HTTPS hostname origin, e.g. https://hourmere.example.com.
# Caddy obtains/renews TLS certificates and redirects HTTP to HTTPS automatically.
{$PUBLIC_URL} {
	# Preserve Host and set X-Forwarded-For/Proto; Caddy ignores client-supplied
	# forwarded values by default. Do not trust upstream proxies here without review.
	reverse_proxy app:3000
}
