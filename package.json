{
  "name": "hourmere",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "cli": "node tools/cli/src/index.ts",
    "dev": "node scripts/dev.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "node --env-file-if-exists=.env packages/db/src/migrate-cli.ts && node --env-file-if-exists=.env packages/jobs/src/migrate-cli.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tools/api-types && tsc -p scripts",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "start": "node apps/server/src/index.ts",
    "auth:sql": "npm run --workspace @hourmere/auth schema:sql",
    "api:types": "npm run --silent --workspace @hourmere/api-types generate",
    "db:types": "kysely-codegen --dialect postgres --date-parser string --default-schema public --exclude-pattern \"{public.schema_migrations,pgboss.*}\" --out-file packages/db/src/tables.ts",
    "test:e2e": "npm run test --workspace @hourmere/e2e",
    "test:e2e:privacy": "npm run test:privacy --workspace @hourmere/e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
