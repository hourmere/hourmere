{
  "format": "hourmere.make.manual-recipe.v1",
  "id": "find-slots-create-booking",
  "title": "Find available slots and create a booking",
  "webhookEvents": [],
  "requests": [
    {
      "method": "GET",
      "path": "/api/v1/public/{handle}/{slug}/slots",
      "query": ["start", "end", "durationMinutes"],
      "response": {
        "200": ["data", "data.start"],
        "400": ["error", "field"]
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/public/{handle}/{slug}/bookings",
      "headers": ["Idempotency-Key"],
      "body": [
        "start",
        "durationMinutes",
        "invitee",
        "invitee.name",
        "invitee.email",
        "invitee.timeZone",
        "responses"
      ],
      "response": {
        "201": ["booking.id", "manageToken"],
        "200": ["booking.id", "manageToken"],
        "400": ["error", "field"],
        "409": ["error"]
      }
    }
  ],
  "connections": [],
  "settings": {
    "documentation": "find-slots-create-booking.md",
    "apiKeyScope": "none; public endpoints use no API key",
    "signatureVerification": "Not applicable: outbound REST requests."
  }
}
