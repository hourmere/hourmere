{
  "name": "@hourmere/zapier-hourmere",
  "version": "0.1.0",
  "private": true,
  "description": "Private Zapier integration for Hourmere bookings",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --check index.js && node --check lib.js && node --check hooks.js",
    "test": "vitest run --config vitest.config.mjs --maxWorkers=2 --no-fsModuleCache",
    "validate": "DISABLE_ZAPIER_ANALYTICS=1 NO_UPDATE_NOTIFIER=1 zapier-platform validate --skip-build --without-style",
    "typecheck": "tsc -p tsconfig.json",
    "_zapier-build": "node scripts/guard-build.js",
    "upload": "node scripts/guard-build.js && zapier-platform upload",
    "build:verify": "DISABLE_ZAPIER_ANALYTICS=1 NO_UPDATE_NOTIFIER=1 node scripts/verify-build.js"
  },
  "dependencies": {
    "zapier-platform-core": "19.2.1"
  },
  "devDependencies": {
    "zapier-platform-cli": "19.3.0",
    "nock": "15.0.5",
    "vitest": "5.0.5",
    "typescript": "7.0.2",
    "@types/node": "26.6.5"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "@babel/core": {
      ".": "7.29.7",
      "semver": "6.3.1"
    },
    "@babel/generator": "7.29.8",
    "@babel/helper-compilation-targets": {
      ".": "7.29.7",
      "semver": "6.3.1"
    },
    "@babel/helper-create-class-features-plugin": {
      ".": "7.29.7",
      "semver": "6.3.1"
    },
    "@babel/helper-module-transforms": "7.29.7",
    "@babel/helper-skip-transparent-expression-wrappers": "7.29.7",
    "@babel/helper-string-parser": "7.29.7",
    "@babel/helpers": "7.29.10",
    "@babel/parser": "7.29.9",
    "@babel/register": "7.29.7",
    "@babel/traverse": "7.29.10",
    "@babel/types": "7.29.8",
    "@oxc-project/types": "0.155.0",
    "@types/estree": "1.0.9",
    "ansi-regex@^6": "6.4.0",
    "bare-url": "2.5.5",
    "baseline-browser-mapping": "2.11.31",
    "browserslist": "4.29.4",
    "caniuse-lite": "1.0.30001819",
    "dateformat": "5.0.4",
    "electron-to-chromium": "1.5.463",
    "flow-estree": "0.337.0",
    "flow-parser": "0.337.0",
    "ip-address": "10.7.4",
    "magic-string": "1.4.3",
    "make-dir": {
      "semver": "5.7.2"
    },
    "node-releases": "2.0.60",
    "postcss": "8.5.31",
    "rolldown": "1.2.15",
    "tinybench": "6.2.2",
    "tslib": "2.8.1",
    "vite": "8.3.5"
  }
}
