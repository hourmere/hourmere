exports[`the invitee’s manage page > renders the existing booking summary when there is no routing provenance 1`] = `"<div class="card public-card manage"><h1 tabindex="-1">Your booking</h1><dl class="booking-details"><div class="details-row"><dt>What</dt><dd><bdi>Intro call</bdi></dd></div><div class="details-row"><dt>Status</dt><dd>Confirmed</dd></div><div class="details-row"><dt>When</dt><dd><span><time datetime="2026-11-02T14:00:00.000Z">Monday, November 2, 2026</time><br>9:00 – 9:30 AM<span class="muted"> (America/New York, <span class="time-offset">GMT-05:00)</span></span></span></dd></div><div class="details-row"><dt>Where</dt><dd>Phone call: <a href="tel:+49301234567"><bdi dir="ltr">+49 30 1234567</bdi></a></dd></div><div class="details-row"><dt>Host</dt><dd><bdi>Ada Lovelace</bdi></dd></div><div class="details-row"><dt>Booked by</dt><dd><bdi>Grace Hopper</bdi> (<bdi dir="ltr">grace@example.com</bdi>)</dd></div></dl><p class="muted">Accepting or declining the calendar invitation does not cancel the booking. To cancel, use “Cancel booking” here.</p><div class="manage-actions"><button type="button" class="button button-primary">Reschedule</button><button type="button" class="button">Cancel booking</button></div></div>"`;
