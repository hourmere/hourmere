/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Exact page paths only: the app origin is not added to other pages' policies.
# Inline styles cover Astro's inlined page CSS and the popup's older-browser stylesheet fallback.
/embed-test
  Content-Security-Policy: default-src 'self'; script-src 'self' https://app.hourmere.com; frame-src https://app.hourmere.com; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/embed-test/
  Content-Security-Policy: default-src 'self'; script-src 'self' https://app.hourmere.com; frame-src https://app.hourmere.com; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/embed-test/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self' https://app.hourmere.com; frame-src https://app.hourmere.com; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
