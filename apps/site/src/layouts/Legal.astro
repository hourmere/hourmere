---
import Base from './Base.astro'

interface Props {
  title: string
  description: string
  path: string
  /** Effective date as YYYY-MM-DD. */
  effective: string
  /** Also show the effective date as this policy's last-updated date. */
  lastUpdated?: boolean
  /** Section anchors for the table of contents, in page order. */
  sections: { id: string; title: string }[]
}

const { title, description, path, effective, lastUpdated, sections } = Astro.props
const effectiveLabel = new Date(`${effective}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})
---

<Base title={`${title} | Hourmere`} description={description} path={path}>
  <article class="container legal">
    <header class="legal-header">
      <p class="eyebrow">Hourmere</p>
      <h1>{title}</h1>
      <p class="effective">Effective date: <time datetime={effective}>{effectiveLabel}</time></p>
      {lastUpdated && <p class="effective">Last updated: <time datetime={effective}>{effectiveLabel}</time></p>}
    </header>
    <div class="prose">
      <slot name="intro" />
      <nav class="toc" aria-labelledby="toc-title">
        <h2 id="toc-title">Contents</h2>
        <ol>
          {
            sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>{section.title}</a>
              </li>
            ))
          }
        </ol>
      </nav>
      <slot />
    </div>
  </article>
</Base>

<style>
  .container.legal {
    max-width: 800px;
    padding-block: 56px 80px;
  }

  .legal-header h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 46px);
    font-weight: 800;
  }

  .effective {
    margin: 12px 0 0;
    color: var(--muted);
  }

  .prose {
    margin-top: 32px;
  }

  .prose :global(h2) {
    margin: 48px 0 12px;
    font-size: 26px;
    font-weight: 800;
    scroll-margin-top: 24px;
  }

  .prose :global(h3) {
    margin: 28px 0 8px;
    font-size: 19px;
    font-weight: 750;
    scroll-margin-top: 24px;
  }

  .prose :global(p),
  .prose :global(li) {
    max-width: 72ch;
  }

  .prose :global(p) {
    margin: 0 0 16px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 16px;
    padding-left: 1.4em;
  }

  .prose :global(li + li) {
    margin-top: 8px;
  }

  .prose :global(.summary) {
    margin: 0 0 32px;
    padding: 20px 24px;
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .prose :global(.summary h2) {
    margin-top: 0;
    font-size: 20px;
  }

  .prose :global(.summary ul) {
    margin-bottom: 0;
  }

  .prose :global(p.callout) {
    max-width: none;
    padding: 16px 20px;
    border-left: 4px solid var(--cobalt);
    border-radius: 0 10px 10px 0;
    background: var(--accent-soft);
  }

  .toc {
    margin: 0 0 8px;
    padding: 20px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .toc h2 {
    margin: 0 0 10px;
    font-size: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .toc ol {
    margin: 0;
    columns: 2 240px;
    column-gap: 32px;
  }

  .toc li {
    break-inside: avoid;
  }

  .toc li + li {
    margin-top: 4px;
  }
</style>
