---
import Base from './Base.astro'

interface Props {
  title: string
  description: string
  path: string
  /** Effective date as YYYY-MM-DD. */
  effective: string
  /** Also show the effective date as this policy's last-updated date. */
  lastUpdated?: boolean
  /** Section anchors for the table of contents, in page order. */
  sections: { id: string; title: string }[]
}

const { title, description, path, effective, lastUpdated, sections } = Astro.props
const effectiveLabel = new Date(`${effective}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})
---

<Base title={`${title} | Hourmere`} description={description} path={path}>
  <article class="container legal">
    <header class="legal-header">
      <p class="eyebrow">Hourmere</p>
      <h1>{title}</h1>
      <p class="effective">Effective date: <time datetime={effective}>{effectiveLabel}</time></p>
      {lastUpdated && <p class="effective">Last updated: <time datetime={effective}>{effectiveLabel}</time></p>}
    </header>
    <div class="prose">
      <slot name="intro" />
      <nav id="contents" class="toc" aria-labelledby="toc-title">
        <h2 id="toc-title">Contents</h2>
        <ol>
          {
            sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>{section.title}</a>
              </li>
            ))
          }
        </ol>
      </nav>
      <slot />
    </div>
  </article>
</Base>

<style>
  .container.legal {
    max-width: 50rem;
    padding-block: 3.5rem 5rem;
    font-size: 1.0625rem;
  }

  .legal-header .eyebrow {
    margin-bottom: 0.625rem;
    font-size: 0.875rem;
  }

  .legal-header h1 {
    margin: 0;
    font-size: clamp(2.125rem, 5vw, 2.875rem);
    font-weight: 800;
  }

  .effective {
    margin: 0.75rem 0 0;
    color: var(--muted);
  }

  .prose {
    margin-top: 2rem;
  }

  .prose :global(h2) {
    margin: 3rem 0 0.75rem;
    font-size: 1.625rem;
    font-weight: 800;
    scroll-margin-top: 1.5rem;
  }

  .prose :global(h3) {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.1875rem;
    font-weight: 750;
    scroll-margin-top: 1.5rem;
  }

  .prose :global(p),
  .prose :global(li) {
    max-width: 72ch;
  }

  .prose :global(p) {
    margin: 0 0 1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.4em;
  }

  .prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .prose :global(.summary) {
    margin: 0 0 2rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .prose :global(.summary h2) {
    margin-top: 0;
    font-size: 1.25rem;
  }

  .prose :global(.summary ul) {
    margin-bottom: 0;
  }

  .prose :global(p.callout) {
    max-width: none;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--cobalt);
    border-radius: 0 10px 10px 0;
    background: var(--accent-soft);
  }

  .toc {
    margin: 0 0 0.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .toc h2 {
    margin: 0 0 0.625rem;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .toc ol {
    margin: 0;
    columns: 2 15rem;
    column-gap: 2rem;
  }

  .toc li {
    break-inside: avoid;
  }

  .toc li + li {
    margin-top: 0.25rem;
  }

  .prose :global(.back-to-contents) {
    margin-block: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .prose :global(.back-to-contents a) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .toc,
    .prose :global(.back-to-contents) {
      display: none;
    }

    .container.legal {
      max-width: none;
      padding: 0;
    }

    .prose :global(h2),
    .prose :global(h3) {
      break-after: avoid;
    }

    .prose :global(a[href^="http"])::after {
      content: " (" attr(href) ")";
      font-size: 0.9em;
      overflow-wrap: anywhere;
    }
  }
</style>
