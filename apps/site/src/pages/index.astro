---
import BookingPreview from '../components/BookingPreview.astro'
import Base from '../layouts/Base.astro'
import { company, contact, launchUpdatesHref, site } from '../site'

const steps = [
  {
    title: 'Connect your calendar',
    text: 'Connect Google Calendar or Microsoft 365. Hourmere reads your free/busy times, so it only offers times when you are actually free.',
  },
  {
    title: 'Share your booking link',
    text: 'Send your link, or embed the booking widget on your website. Invitees pick a time that works for them.',
  },
  {
    title: 'The meeting is booked',
    text: 'Hourmere adds the event to your calendar and sends email confirmations and reminders.',
  },
]

const features = [
  {
    title: 'Booking links',
    text: 'Create event types and share a booking link. The Free plan includes unlimited event types and bookings.',
  },
  {
    title: 'Calendar sync',
    text: 'Works with Google Calendar and Microsoft 365. Hourmere reads free/busy information to avoid conflicts and writes booked meetings to your calendar.',
  },
  {
    title: 'Confirmations and reminders',
    text: 'Hourmere sends email confirmations and reminders, so everyone knows when the meeting is.',
  },
  {
    title: 'Embeddable booking widget',
    text: 'Put the booking widget on your own website, so visitors can book without leaving it.',
  },
  {
    title: 'API and remote MCP server',
    text: 'AI assistants and your own code can list event types, check availability, and book, reschedule or cancel meetings.',
  },
  {
    title: 'Open source',
    text: 'The source code will be published under AGPL-3.0, so you will be able to read it, run it on your own server and change it to fit your needs.',
  },
]

const agentActions = [
  'List your event types',
  'Check your availability',
  'Book a meeting',
  'Reschedule a meeting',
  'Cancel a meeting',
]

const plans = [
  { name: 'Self-hosted', price: '$0', unit: '', note: 'Free under AGPL-3.0, on your own server.' },
  { name: 'Free', price: '$0', unit: '', note: 'Unlimited event types and bookings.' },
  { name: 'Pro', price: '$8', unit: 'per seat / month', note: 'Plan details at launch.' },
  { name: 'Team', price: '$14', unit: 'per seat / month', note: 'Plan details at launch.' },
]
---

<Base
  title="Hourmere: open-source scheduling for people and AI agents"
  description={site.description}
  path="/"
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="status"><span class="status-dot" aria-hidden="true"></span>In development</p>
        <h1>Open-source scheduling for people and AI agents.</h1>
        <p class="lead">
          Hourmere is an alternative to Calendly, being built as open-source software. Share a
          booking link and let invitees pick a time that works. Your AI assistant can check your availability and book, reschedule
          or cancel meetings through an API and a remote MCP server.
        </p>
        <p class="lead">
          It is designed to be self-hosted for free with Docker Compose, or used as a managed cloud
          service.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={launchUpdatesHref}>Get launch updates</a>
          <a class="btn" href={site.github}>Follow on GitHub</a>
        </div>
        <p class="note">
          Hourmere is not available yet, so there is no sign-up today. Email us and we will let you
          know when it launches.
        </p>
      </div>
      <BookingPreview />
    </div>
  </section>

  <section class="section section-soft" id="how-it-works" aria-labelledby="how-it-works-title">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2 id="how-it-works-title">From link to meeting in three steps</h2>
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li class="card">
              <span class="step-number" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="features" aria-labelledby="features-title">
    <div class="container">
      <p class="eyebrow">Features</p>
      <h2 id="features-title">What Hourmere does</h2>
      <p class="section-intro">
        The essentials of a scheduling tool, open to the AI assistants you already use.
      </p>
      <div class="grid">
        {
          features.map((feature) => (
            <div class="card">
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft" id="agents" aria-labelledby="agents-title">
    <div class="container split">
      <div>
        <p class="eyebrow">For AI agents</p>
        <h2 id="agents-title">Your AI assistant can book meetings for you</h2>
        <p class="section-intro">
          Hourmere is built to be used by AI agents as well as people. Connect an assistant that
          supports the Model Context Protocol (MCP) to Hourmere's remote MCP server, or call the
          API from your own tools.
        </p>
        <p class="agents-note">
          Agents can access your account only with an API key that you create. OAuth for AI
          connectors is planned.
        </p>
      </div>
      <div class="card agent-card">
        <h3>With your permission, an assistant can</h3>
        <ul class="checklist">
          {agentActions.map((action) => <li>{action}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="calendar-data" aria-labelledby="calendar-data-title">
    <div class="container narrow">
      <p class="eyebrow">Your data</p>
      <h2 id="calendar-data-title">How Hourmere uses your calendar data</h2>
      <p class="section-intro">
        When you connect Google Calendar or Microsoft 365, Hourmere asks for permission to read your
        calendars, so it can work out when you are available, and to add, update and remove the
        calendar events for your bookings.
      </p>
      <ul class="checklist data-list">
        <li>
          Calendar data is used only for scheduling: to show your available times, avoid
          double-booking and keep booked meetings on your calendar.
        </li>
        <li>
          It is never sold, never used for advertising and never used to train generalized AI or
          machine learning models.
        </li>
        <li>
          From your other events, Hourmere keeps only their times, whether they make you busy, and
          the identifiers it needs to keep them in sync. It does not store their titles,
          descriptions or attendees.
        </li>
        <li>Invitees see the times you are available, not the details of your calendar events.</li>
        <li>AI assistants get access to your account only when you give them an API key.</li>
        <li>
          You can disconnect a calendar at any time. Hourmere then stops reading it and deletes the
          calendar data it stored, as described in the Privacy Policy.
        </li>
        <li>
          If you sign in with Google or Microsoft, Hourmere receives your name, email address and
          profile picture (if available). It uses them to create your account and sign you in, and
          as your account profile: your name (and picture, if shown) appears on your booking pages
          and in booking emails, and account and booking emails go to your email address.
        </li>
      </ul>
      <p>
        Read the <a href="/privacy">Privacy Policy</a> for details, including how Hourmere
        meets the <a href="/privacy#google-user-data">Google API Services User Data Policy</a>.
      </p>
    </div>
  </section>

  <section class="section section-soft" id="self-host" aria-labelledby="self-host-title">
    <div class="container">
      <p class="eyebrow">Self-host or cloud</p>
      <h2 id="self-host-title">Run it yourself, or let us run it</h2>
      <p class="section-intro">The same open-source software will power both.</p>
      <div class="grid two">
        <div class="card">
          <h3>Self-hosted</h3>
          <p>
            Hourmere is designed to be self-hosted with Docker Compose, for free. A self-hosted
            instance keeps its data on your own infrastructure; {company.shortName} does not receive
            it.
          </p>
          <p class="small">
            The source code will be published on GitHub under {site.license.name} when Hourmere
            launches.
          </p>
        </div>
        <div class="card">
          <h3>Hourmere Cloud</h3>
          <p>
            We will host, update and operate Hourmere for you, so you can share your booking link
            without running a server. Hourmere Cloud is in development.
          </p>
          <p class="small">
            Operated by <a href={company.url}>{company.name}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="pricing" aria-labelledby="pricing-title">
    <div class="container">
      <p class="eyebrow">Pricing</p>
      <h2 id="pricing-title">Free to self-host. Simple cloud plans.</h2>
      <p class="section-intro">
        These are the planned prices for Hourmere Cloud. Final plan details will be published at
        launch.
      </p>
      <div class="grid plans">
        {
          plans.map((plan) => (
            <div class="card plan">
              <h3>{plan.name}</h3>
              <p class="price">
                {plan.price}
                {plan.unit && <span>{plan.unit}</span>}
              </p>
              <p>{plan.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft" id="faq" aria-labelledby="faq-title">
    <div class="container narrow">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Questions</h2>
      <div class="faq">
        <details>
          <summary>Can I use Hourmere today?</summary>
          <p>
            Not yet. Hourmere is in development.
            Email <a href={launchUpdatesHref}>{contact.hello}</a> to hear when it launches.
          </p>
        </details>
        <details>
          <summary>Is Hourmere really open source?</summary>
          <p>
            Yes. Hourmere's source code will be published on GitHub under the GNU Affero General
            Public License v3.0 (AGPL-3.0), and you will be able to self-host it for free.
          </p>
        </details>
        <details>
          <summary>Which calendars does Hourmere work with?</summary>
          <p>Google Calendar and Microsoft 365.</p>
        </details>
        <details>
          <summary>What can an AI assistant do with Hourmere?</summary>
          <p>
            With an API key that you create, an assistant can list your event types, check your
            availability, and book, reschedule or cancel meetings, through the API or the remote MCP
            server. MCP clients can also connect with OAuth 2.1 when the instance operator
            enables it.
          </p>
        </details>
        <details>
          <summary>Who makes Hourmere?</summary>
          <p>
            <a href={company.url}>{company.name}</a>, a Delaware limited liability company. Write to
            us at <a href={`mailto:${contact.hello}`}>{contact.hello}</a>.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="container closing-inner">
      <h2 id="closing-title">Hourmere is in development.</h2>
      <div class="cta-row">
        <a class="btn btn-light" href={launchUpdatesHref}>Get launch updates</a>
        <a class="btn btn-outline-light" href={site.github}>Follow on GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: 64px 72px;
  }

  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.25fr 1fr;
      gap: 64px;
    }
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 20px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
  }

  .status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--amber);
  }

  h1 {
    margin: 0 0 20px;
    font-size: clamp(36px, 6vw, 58px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .lead {
    max-width: 640px;
    margin: 0 0 16px;
    color: var(--muted);
    font-size: clamp(18px, 2.2vw, 20px);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .note {
    max-width: 560px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  .steps {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .step-number {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--cobalt);
    color: #ffffff;
    font-weight: 800;
  }

  .split {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1.2fr 1fr;
      gap: 56px;
    }
  }

  .agents-note {
    margin: 0;
    font-weight: 650;
  }

  .card.agent-card h3 {
    margin-bottom: 14px;
  }

  .checklist {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checklist li {
    position: relative;
    padding-left: 30px;
  }

  .checklist li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.3em;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--cobalt);
    box-shadow: inset 0 0 0 4px var(--accent-soft);
  }

  .agent-card .checklist li::before {
    box-shadow: inset 0 0 0 4px var(--surface);
  }

  /* Narrow text column that stays aligned with the other sections. */
  .container.narrow > * {
    max-width: 820px;
  }

  .data-list {
    margin-bottom: 28px;
  }

  .grid.two {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  }

  .card p.small {
    margin-top: 14px;
    font-size: 15px;
  }

  .grid.plans {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .card .price {
    margin: 4px 0 10px;
    color: var(--text);
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .card .price span {
    display: block;
    color: var(--muted);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0;
  }

  .faq {
    border-top: 1px solid var(--border);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    padding: 18px 0;
    cursor: pointer;
    font-size: 18px;
    font-weight: 750;
  }

  details p {
    margin: 0 0 18px;
    color: var(--muted);
  }

  .closing {
    padding-block: 64px;
    background: var(--deep-mere);
    color: #ffffff;
  }

  .closing :focus-visible {
    outline-color: #ffffff;
  }

  .closing-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }

  .closing h2 {
    margin: 0;
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 800;
  }

  .closing .cta-row {
    margin-top: 0;
  }

  .btn.btn-light {
    border-color: #ffffff;
    background: #ffffff;
    color: var(--deep-mere);
  }

  .btn.btn-light:hover {
    border-color: var(--mist);
    background: var(--mist);
  }

  .btn.btn-outline-light {
    border-color: rgb(255 255 255 / 0.6);
    background: transparent;
    color: #ffffff;
  }

  .btn.btn-outline-light:hover {
    border-color: #ffffff;
  }
</style>
