---
import { site } from '../site'
import Logo from './Logo.astro'

const links = [
  { href: '/#features', label: 'Features' },
  { href: '/#agents', label: 'AI agents' },
  { href: '/#self-host', label: 'Self-host' },
  { href: '/#pricing', label: 'Pricing' },
]
---

<header class="site-header">
  <div class="container bar">
    <a class="home" href="/" aria-label="Hourmere home"><Logo /></a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li class="section-link">
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a class="github" href={site.github}>
            <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span>GitHub</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }

  .home {
    color: var(--text);
    text-decoration: none;
  }

  ul {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 650;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  .github {
    color: var(--text);
  }

  /* On narrow screens the section links collapse; the page itself is short to scroll. */
  @media (max-width: 760px) {
    .section-link {
      display: none;
    }
  }
</style>
