---
// Starlight footer with the same site links as the rest of hourmere.com.
import Default from '@astrojs/starlight/components/Footer.astro'
import { company, contact, site } from '../site'
---

<Default />
<nav class="site-links" aria-label="Site">
  <a href="/">Hourmere</a>
  <a href="/privacy">Privacy Policy</a>
  <a href="/terms">Terms of Service</a>
  <a href={site.github}>GitHub</a>
  <a href={company.url}>Cobaltmere</a>
  <a href={`mailto:${contact.hello}`}>Contact</a>
</nav>

<style>
  .site-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
  }

  .site-links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .site-links a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
</style>
